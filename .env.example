# PostgreSQL connection (required for API + Drizzle)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit

# Clerk authentication (required for sign-in and API proxy)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Frontend (artifacts/pm-app) — copy to artifacts/pm-app/.env.local
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: Clerk proxy URL when running behind the API server (production: /api/__clerk)
# VITE_CLERK_PROXY_URL=/api/__clerk

# Optional: only if API is on a different domain than the frontend
# VITE_API_URL=https://your-api.example.com

# API server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
